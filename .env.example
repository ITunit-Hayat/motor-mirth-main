# =============================================================================
# MZAB MOTORS — Supabase Environment Variables Configuration
# =============================================================================
#
# Add these variables to your local .env file OR in the Vercel Project Settings:
# Project Settings -> Environment Variables (for Production, Preview, Development)
#
# Primary keys (Vite / TanStack Start):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Compatible Next.js aliases (also automatically supported if you already added them in Vercel):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
